{
  "manifest_version": "0.3",
  "name": "peekaping-pp-mcp",
  "display_name": "Peekaping",
  "version": "4.19.1",
  "description": "The first CLI for Peekaping: full monitor CRUD plus offline down/flapping/uptime analytics no single API call can answer.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/peekaping-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/peekaping-pp-mcp",
      "args": [],
      "env": {
        "PEEKAPING_API_KEY": "${user_config.peekaping_api_key}"
      }
    }
  },
  "user_config": {
    "peekaping_api_key": {
      "type": "string",
      "title": "PEEKAPING_API_KEY",
      "description": "Sets PEEKAPING_API_KEY for the Peekaping MCP server.",
      "sensitive": true,
      "required": true
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
